{
  "name": "@safanoor/ui",
  "author": "Minimals",
  "version": "7.3.0",
  "description": "Next Starter & JavaScript",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3033",
    "dev:turbo": "next dev -p 3033 --turbopack",
    "start": "next start -p 3033",
    "build": "next build",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint --fix \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:print": "npx eslint --print-config eslint.config.mjs > eslint-show-config.json",
    "fm:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\"",
    "fm:fix": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "fix:all": "npm run lint:fix && npm run fm:fix",
    "clean": "rm -rf node_modules .next out dist build",
    "re:dev": "yarn clean && yarn install && yarn dev",
    "re:build": "yarn clean && yarn install && yarn build",
    "re:build-npm": "npm run clean && npm install && npm run build",
    "typecheck": "tsc --noEmit",
    "api:generate": "openapi-typescript ../api/openapi.json -o src/api/generated/schema.d.ts",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource-variable/dm-sans": "^5.2.6",
    "@fontsource-variable/inter": "^5.2.6",
    "@fontsource-variable/nunito-sans": "^5.2.6",
    "@fontsource-variable/public-sans": "^5.2.6",
    "@fontsource-variable/vazirmatn": "^5.2.5",
    "@fontsource/barlow": "^5.2.6",
    "@hookform/resolvers": "^5.1.1",
    "@iconify/react": "^6.0.0",
    "@mui/icons-material": "^7.1.2",
    "@mui/lab": "^7.0.0-beta.14",
    "@mui/material": "^7.1.2",
    "@mui/material-nextjs": "^7.1.1",
    "@mui/stylis-plugin-rtl": "^7.1.0",
    "@mui/x-charts": "^8.5.3",
    "@mui/x-data-grid": "^8.5.3",
    "@mui/x-date-pickers": "^8.5.3",
    "@mui/x-tree-view": "^8.5.3",
    "@safanoor/shared": "file:../packages/shared",
    "@tanstack/react-query": "^5.74.4",
    "autosuggest-highlight": "^3.3.4",
    "axios": "^1.10.0",
    "date-fns-jalali": "4.4.0-0",
    "dayjs": "^1.11.13",
    "es-toolkit": "^1.39.3",
    "framer-motion": "^12.18.1",
    "i18next": "^24.2.3",
    "i18next-browser-languagedetector": "^8.0.4",
    "i18next-resources-to-backend": "^1.2.1",
    "jalaliday": "^2.3.0",
    "minimal-shared": "^1.0.15",
    "next": "15.5.28",
    "nprogress": "^0.2.0",
    "openapi-fetch": "^0.14.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-easy-crop": "^6.2.4",
    "react-hook-form": "^7.58.1",
    "react-i18next": "^15.4.1",
    "simplebar-react": "^3.3.0",
    "sonner": "^2.0.3",
    "stylis": "^4.3.6",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/stylis": "^4.2.7",
    "eslint": "^9.29.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-perfectionist": "^4.15.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^16.2.0",
    "openapi-typescript": "^7.10.0",
    "prettier": "^3.5.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.45.0"
  },
  "resolutions": {
    "zod": "3.25.76"
  }
}
