{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "..",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testEnvironment": "node",
  "setupFiles": [
    "<rootDir>/test/setup.ts"
  ],
  "testTimeout": 60000,
  "moduleNameMapper": {
    "^pg-boss$": "<rootDir>/test/pg-boss.cjs"
  }
}
